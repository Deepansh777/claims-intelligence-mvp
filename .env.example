# Database
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app
# Read-only role for AI-generated SQL (SELECT on raw/mart/ref only). `alembic upgrade head` creates it.
ANALYTICS_DATABASE_URL=postgresql+asyncpg://ci_analyst_ro:ci_analyst_ro@db:5432/app

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# App
ENVIRONMENT=development
# Days each chat message is kept, measured from its own creation time.
CHAT_RETENTION_DAYS=15
CORS_ORIGINS=["http://localhost:5173"]
VITE_API_BASE_URL=/api/v1
